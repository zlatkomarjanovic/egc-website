{
  "name": "egc-site",
  "private": true,
  "version": "1.0.0",
  "description": "EGC monorepo — standalone Sanity Studio + Next.js web app",
  "workspaces": [
    "studio",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:studio": "npm run dev --workspace=studio",
    "deploy:studio": "npm run deploy --workspace=studio -- --yes",
    "build": "npm run build --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build:studio": "npm run build --workspace=studio",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspace=web",
    "schema:deploy": "npm run schema:deploy --workspace=studio",
    "import:cms": "node scripts/import-to-sanity.mjs",
    "push:sanity": "node scripts/import-to-sanity.mjs && node scripts/push-to-sanity.mjs",
    "generate:pages": "node scripts/generate-pages.mjs"
  },
  "devDependencies": {
    "@sanity/import": "^6.0.3",
    "node-html-parser": "^7.1.0",
    "uuid": "11.1.1"
  },
  "overrides": {
    "glob": "^13.0.6",
    "uuid": "$uuid",
    "typeid-js": {
      "uuid": "$uuid"
    }
  },
  "engines": {
    "node": "22.x"
  }
}

# ----------------------------------------------------------------------------
# Copy to .env.local for local dev, and set the same in Vercel → Project →
# Settings → Environment Variables for production. All are OPTIONAL: the site
# builds and runs without them (forms log to the server, CMS routes 404).
# ----------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, and CSRF origin allow-list)
NEXT_PUBLIC_SITE_URL=https://egcnyc.org

# --- Contact form email (Resend) --------------------------------------------
# Get a key at https://resend.com . Until set, submissions are logged server-side.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@egcnyc.org
# Must be a verified sender/domain in Resend once you go live:
CONTACT_FROM_EMAIL=EGC Website <onboarding@resend.dev>

# --- Newsletter (ConvertKit / Kit) — optional, no signup form wired yet ------
KIT_API_KEY=
KIT_FORM_ID=

# --- Sanity CMS (set these once the project exists) --------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Write token for CLI imports / server mutations (never commit the real value):
SANITY_API_TOKEN=

# --- Rate limiting (optional, recommended for production) --------------------
# Without these, a per-instance in-memory limiter is used. For accurate limits
# across serverless instances, create an Upstash Redis DB and paste the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

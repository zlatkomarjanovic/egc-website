# ----------------------------------------------------------------------------
# EGC website — environment variables
#
# Local dev:
#   cp .env.example .env.local
#   cp .env.local web/.env.local
#
# Production (Vercel → Project → Settings → Environment Variables):
#   Add the same keys. Required for CMS: all NEXT_PUBLIC_SANITY_* + SANITY_API_TOKEN
# ----------------------------------------------------------------------------
#
# Sanity org:     oVUjX2dez
# Sanity project:  nn9xx2r4  → https://www.sanity.io/manage/project/nn9xx2r4
# Hosted Studio:   https://egc-content.sanity.studio/
# Dataset:         production

# Public site URL (canonical URLs, sitemap, CSRF allow-list)
NEXT_PUBLIC_SITE_URL=https://egcnyc.org

# --- Sanity CMS (EGC project nn9xx2r4) --------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=nn9xx2r4
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Editor/read token from Sanity → Project → API → Tokens (never commit the real value)
# Also set as SANITY_AUTH_TOKEN if your tooling expects that name.
SANITY_API_TOKEN=
SANITY_AUTH_TOKEN=

# --- Contact form email (Resend) --------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@egcnyc.org
CONTACT_FROM_EMAIL=EGC Website <onboarding@resend.dev>

# --- Newsletter (ConvertKit / Kit) — optional --------------------------------
KIT_API_KEY=
KIT_FORM_ID=

# --- Rate limiting (optional; Upstash for serverless) ------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

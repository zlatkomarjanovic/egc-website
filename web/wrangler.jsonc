{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "egc-website",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "account_id": "f31a4cf45b22e72341e3c81ab4572726",
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.egcnyc.org",
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "nn9xx2r4",
    "NEXT_PUBLIC_SANITY_DATASET": "production",
    "NEXT_PUBLIC_SANITY_API_VERSION": "2024-10-01"
  },
  "workers_dev": true,
  "routes": [
    {
      "custom_domain": true,
      "pattern": "egcnyc.org"
    },
    {
      "custom_domain": true,
      "pattern": "www.egcnyc.org"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "d1_databases": [
    {
      "database_name": "egc-submissions",
      "binding": "EGC_SUBMISSIONS",
      "database_id": "9ecbef51-9c4b-4b94-9626-5ac63a27d5e8"
    }
  ],
  "preview_urls": false
}